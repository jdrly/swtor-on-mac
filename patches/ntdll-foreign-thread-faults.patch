--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -2490,6 +2490,24 @@
 }
 
 
+/***********************************************************************
+ *           is_foreign_thread_fault
+ *
+ * A thread Wine did not create (a system framework's dispatch worker, Metal's completion
+ * queue) has no TEB, and the handlers below fault inside themselves without one. Set the
+ * signal's default action and send the signal to this thread again: it stays blocked until
+ * the handler returns, and then ends the process, also where the instruction would not fault
+ * again (a breakpoint returns past its int3, a signal from kill() has no instruction).
+ */
+static BOOL is_foreign_thread_fault( int sig )
+{
+    if (NtCurrentTeb()) return FALSE;
+    signal( sig, SIG_DFL );
+    raise( sig );
+    return TRUE;
+}
+
+
 /**********************************************************************
  *		segv_handler
  *
@@ -2501,6 +2519,8 @@
     EXCEPTION_RECORD rec = { 0 };
     struct xcontext context;
 
+    if (is_foreign_thread_fault( signal )) return;
+
     rec.ExceptionAddress = (void *)RIP_sig(ucontext);
     save_context( &context, ucontext );
 
@@ -2597,6 +2617,8 @@
     EXCEPTION_RECORD rec = { 0 };
     struct xcontext context;
 
+    if (is_foreign_thread_fault( signal )) return;
+
     if (handle_syscall_trap( ucontext, siginfo )) return;
 
     rec.ExceptionAddress = (void *)RIP_sig(ucontext);
@@ -2631,6 +2653,8 @@
     EXCEPTION_RECORD rec = { .ExceptionAddress = (void *)RIP_sig(ucontext) };
     struct xcontext context;
 
+    if (is_foreign_thread_fault( signal )) return;
+
     save_context( &context, sigcontext );
 
     switch (siginfo->si_code)
