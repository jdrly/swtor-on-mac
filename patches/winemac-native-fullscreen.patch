+/* ---------- nativefs decision: begin ----------
+   Native fullscreen (SWTOR on Mac): when the game's borderless window covers one screen, the
+   driver moves it into a fullscreen Space of its own and takes it out again.  This is the
+   decision, as plain C over a struct of facts the window recorded, so it can be tested
+   without AppKit: SWTOR on Mac's scripts/test-nativefs-decide.sh cuts it out of the patch,
+   from this line to the end marker, and builds its test against it with clang.
+
+   Every event (a frame or style request from Wine, show and hide, activation, a Space
+   change, a display change, the end of a transition, a timer) only records the window's
+   facts and calls nfs_step(); the window carries out what it returns.  nfs_step() is the
+   only place that decides to start a transition. */
+#include <string.h>
+
+#define NFS_ENTER_STABLE    0.300   /* qualifying this long before entering */
+#define NFS_EXIT_STABLE     0.150   /* not qualifying (or another screen) this long before leaving */
+#define NFS_ENTER_BACKOFF   2.0     /* after a failed entry */
+#define NFS_ENTER_TRIES     3
+#define NFS_EXIT_RETRY      1.0     /* after a failed exit, once */
+#define NFS_SETTLE          1.0     /* after a real display change */
+#define NFS_FIGHT_COUNT     3       /* more than this many corrections ... */
+#define NFS_FIGHT_WINDOW    2.0     /* ... in this many seconds is a fight */
+
+/* What the window knows when it asks (no times in here: a change of any of these restarts the
+   stability clock). */
+struct nfs_facts
+{
+    int option;             /* NativeFullscreen */
+    int top_level;          /* no parent window, latent or not */
+    int ordered_in;         /* shown (minimized windows are ordered in too) */
+    int minimized;
+    int disabled;
+    int no_foreground;
+    int maximized;
+    int borderless;         /* Wine's last style request has no title bar */
+    unsigned int screen;    /* the screen whose frame Wine's last request covers (within 1 pt), 0: none */
+    int request_is_content; /* in a Space: the request equals the window's content there (within 1 pt) */
+    int request_off_screens; /* the request lies on no screen (its display went away) */
+    int displays_captured;
+    int separate_spaces;    /* "Displays have separate Spaces" */
+    int screens;
+    int app_active;
+    int on_active_space;
+    int in_transition;      /* a transition the driver started (or took over) is under way */
+    int in_space;           /* in the driver's Space */
+    int in_other_space;     /* in a Space the player entered by hand, not the driver's */
+    unsigned int space_screen; /* in the driver's Space: its screen */
+};
+
+/* What the decision keeps between calls. */
+struct nfs_state
+{
+    struct nfs_facts last;
+    int have_last;
+    double changed_at;      /* the facts last changed then */
+    double settle_until;    /* a real display change: nothing starts before this */
+    double retry_at;        /* a failed entry: no entry before this */
+    int failed_enters;
+    int declined;           /* the player left the Space by hand, or a fight: stay out */
+    int fight_pending;      /* leave for a fight */
+    double corrections[NFS_FIGHT_COUNT + 1];
+    int exit_failures;      /* 1: retry once at exit_retry_at; 2: stuck */
+    double exit_retry_at;
+};
+
+enum nfs_action { NFS_NOTHING, NFS_WAIT, NFS_ENTER, NFS_EXIT };
+
+enum nfs_reason
+{
+    NFS_REASON_NONE,
+    NFS_REASON_WINDOWED,
+    NFS_REASON_HIDDEN,
+    NFS_REASON_OTHER_SCREEN,
+    NFS_REASON_DISPLAY_CHANGE,
+    NFS_REASON_FIGHT,
+    NFS_REASON_OTHER,
+};
+
+struct nfs_decision
+{
+    enum nfs_action action;
+    enum nfs_reason reason; /* NFS_EXIT */
+    int retry;              /* NFS_EXIT: the retry of a failed exit (its reason is logged already) */
+    double at;              /* NFS_WAIT: ask again then */
+    const char *skipped;    /* qualifies but for this (logged once by the window), or NULL */
+};
+
+static inline const char *nfs_reason_name(enum nfs_reason reason)
+{
+    switch (reason)
+    {
+    case NFS_REASON_WINDOWED: return "windowed";
+    case NFS_REASON_HIDDEN: return "hidden";
+    case NFS_REASON_OTHER_SCREEN: return "other-screen";
+    case NFS_REASON_DISPLAY_CHANGE: return "display-change";
+    case NFS_REASON_FIGHT: return "fight";
+    case NFS_REASON_OTHER: return "other";
+    default: return "none";
+    }
+}
+
+/* The window is a fullscreen game window that could have a Space of its own: everything but
+   the player's choice and the displays. */
+static inline int nfs_is_game_fullscreen(const struct nfs_facts *f)
+{
+    return f->option && f->top_level && f->ordered_in && !f->minimized && !f->disabled &&
+           !f->no_foreground && !f->maximized && f->borderless &&
+           (f->screen || (f->in_space && f->request_is_content));
+}
+
+static inline int nfs_displays_allow(const struct nfs_facts *f)
+{
+    return !f->displays_captured && (f->separate_spaces || f->screens == 1);
+}
+
+/* Q1-Q8 */
+static inline int nfs_qualifies(const struct nfs_facts *f, const struct nfs_state *s)
+{
+    return nfs_is_game_fullscreen(f) && nfs_displays_allow(f) && !s->declined;
+}
+
+static inline enum nfs_reason nfs_exit_reason(const struct nfs_facts *f, const struct nfs_state *s)
+{
+    if (s->fight_pending) return NFS_REASON_FIGHT;
+    if (!f->ordered_in || f->minimized) return NFS_REASON_HIDDEN;
+    if (f->borderless && !f->screen && !f->request_is_content && f->request_off_screens)
+        return NFS_REASON_DISPLAY_CHANGE;
+    if (!f->borderless || !(f->screen || f->request_is_content)) return NFS_REASON_WINDOWED;
+    if (!nfs_displays_allow(f)) return NFS_REASON_DISPLAY_CHANGE;
+    return NFS_REASON_OTHER;
+}
+
+static inline int nfs_facts_equal(const struct nfs_facts *a, const struct nfs_facts *b)
+{
+    return a->option == b->option && a->top_level == b->top_level && a->ordered_in == b->ordered_in &&
+           a->minimized == b->minimized && a->disabled == b->disabled && a->no_foreground == b->no_foreground &&
+           a->maximized == b->maximized && a->borderless == b->borderless && a->screen == b->screen &&
+           a->request_is_content == b->request_is_content && a->request_off_screens == b->request_off_screens &&
+           a->displays_captured == b->displays_captured &&
+           a->separate_spaces == b->separate_spaces && a->screens == b->screens &&
+           a->app_active == b->app_active && a->on_active_space == b->on_active_space &&
+           a->in_transition == b->in_transition && a->in_space == b->in_space &&
+           a->in_other_space == b->in_other_space && a->space_screen == b->space_screen;
+}
+
+static inline struct nfs_decision nfs_wait_until(double at)
+{
+    struct nfs_decision d = { NFS_WAIT, NFS_REASON_NONE, 0, at, NULL };
+    return d;
+}
+
+/* Record the facts at `now` and decide. */
+static inline struct nfs_decision nfs_step(struct nfs_state *s, const struct nfs_facts *f, double now)
+{
+    struct nfs_decision none = { NFS_NOTHING, NFS_REASON_NONE, 0, 0, NULL };
+    struct nfs_decision d = none;
+
+    if (!f->option) return none;
+
+    if (!s->have_last || !nfs_facts_equal(&s->last, f))
+    {
+        s->last = *f;
+        s->have_last = 1;
+        s->changed_at = now;
+    }
+    /* The player's exit and the failed tries hold until the game leaves its fullscreen mode
+       (the next mode switch) or the window goes away. */
+    if (!nfs_is_game_fullscreen(f))
+    {
+        s->declined = 0;
+        s->fight_pending = 0;
+        s->failed_enters = 0;
+        s->retry_at = 0;
+    }
+    if (!f->in_space)
+    {
+        s->exit_failures = 0;
+        s->exit_retry_at = 0;
+    }
+
+    if (f->in_transition) return none;  /* its end asks again */
+    if (f->in_other_space) return none; /* the stock path's, never ours */
+    if (now < s->settle_until) return nfs_wait_until(s->settle_until);
+
+    if (f->in_space)
+    {
+        int qualifies = nfs_qualifies(f, s);
+        int other_screen = qualifies && f->screen && f->screen != f->space_screen;
+
+        if (!s->fight_pending && qualifies && !other_screen)
+        {
+            s->exit_failures = 0; /* nothing to leave for (any more) */
+            return none;          /* stay */
+        }
+        d.action = NFS_EXIT;
+        d.reason = other_screen ? NFS_REASON_OTHER_SCREEN : nfs_exit_reason(f, s);
+        if (s->exit_failures >= 2) return none; /* stuck: logged, nothing more to try */
+        if (s->exit_failures == 1)
+        {
+            if (now < s->exit_retry_at) return nfs_wait_until(s->exit_retry_at);
+            d.retry = 1;
+            return d;
+        }
+        if (s->fight_pending) return d;
+        if (now < s->changed_at + NFS_EXIT_STABLE) return nfs_wait_until(s->changed_at + NFS_EXIT_STABLE);
+        return d;
+    }
+
+    if (!nfs_is_game_fullscreen(f) || s->declined) return none;
+    if (f->displays_captured) { d.skipped = "displays captured"; return d; }
+    if (!nfs_displays_allow(f)) { d.skipped = "displays share one Space"; return d; }
+    if (s->failed_enters >= NFS_ENTER_TRIES) return none;
+    if (now < s->retry_at) return nfs_wait_until(s->retry_at);
+    /* Entering from the background would pull the player to another Space. */
+    if (!f->app_active || !f->on_active_space) return none;
+    if (now < s->changed_at + NFS_ENTER_STABLE) return nfs_wait_until(s->changed_at + NFS_ENTER_STABLE);
+    d.action = NFS_ENTER;
+    return d;
+}
+
+/* An entry failed; returns the try it was (1-3). */
+static inline int nfs_enter_failed(struct nfs_state *s, double now)
+{
+    s->failed_enters++;
+    s->retry_at = now + NFS_ENTER_BACKOFF;
+    return s->failed_enters;
+}
+
+/* An exit failed; returns 1 for "retry once", 2 for "stuck". */
+static inline int nfs_exit_failed(struct nfs_state *s, double now)
+{
+    if (s->exit_failures < 2) s->exit_failures++;
+    s->exit_retry_at = now + NFS_EXIT_RETRY;
+    return s->exit_failures;
+}
+
+/* The player left the driver's Space by hand: stay out until the game leaves its fullscreen
+   mode (or the player enters again by hand). */
+static inline void nfs_declined(struct nfs_state *s)
+{
+    s->declined = 1;
+}
+
+/* The player entered a Space by hand with a window that is the game's fullscreen: it is the
+   driver's from now on. */
+static inline void nfs_taken_over(struct nfs_state *s)
+{
+    s->declined = 0;
+    s->fight_pending = 0;
+    s->failed_enters = 0;
+    s->retry_at = 0;
+}
+
+/* Wine was told the Space's real frame because its request differs; returns 1 when that makes
+   more than NFS_FIGHT_COUNT corrections within NFS_FIGHT_WINDOW: the game insists on its size,
+   so the window leaves (reason fight) and stays out. */
+static inline int nfs_correction(struct nfs_state *s, double now)
+{
+    int i, n = 0;
+
+    memmove(s->corrections + 1, s->corrections, NFS_FIGHT_COUNT * sizeof(s->corrections[0]));
+    s->corrections[0] = now;
+    for (i = 0; i <= NFS_FIGHT_COUNT; i++)
+        if (s->corrections[i] > 0 && now - s->corrections[i] < NFS_FIGHT_WINDOW) n++;
+    if (n <= NFS_FIGHT_COUNT) return 0;
+    s->declined = 1;
+    s->fight_pending = 1;
+    memset(s->corrections, 0, sizeof(s->corrections));
+    return 1;
+}
+
+/* A real display change (not EDR noise): start nothing for NFS_SETTLE. */
+static inline void nfs_displays_changed(struct nfs_state *s, double now)
+{
+    s->settle_until = now + NFS_SETTLE;
+}
+/* ---------- nativefs decision: end ---------- */
+
+/* Native fullscreen (SWTOR on Mac, NativeFullscreen; the decision is above).  While a
+   window is entering, in or leaving the driver's Space, AppKit owns its frame: Wine's frame and
+   style requests are recorded, not applied, and read by the decision as "stay" or "leave". */
+bool macdrv_nativefs_warn_on;
+
+static void nativefs_log(const char* func, NSString* format, ...)
+{
+    va_list args;
+    NSString* message;
+
+    if (!macdrv_nativefs_warn_on) return;
+    va_start(args, format);
+    message = [[NSString alloc] initWithFormat:format arguments:args];
+    va_end(args);
+    fprintf(stderr, "warn:nativefs:%s NATIVEFS: %s\n", func, [message UTF8String]);
+    [message release];
+}
+
+/* Within a point on every edge (Wine's rects are whole pixels, AppKit's points may not be). */
+static BOOL nativefs_rects_close(NSRect a, NSRect b)
+{
+    return fabs(NSMinX(a) - NSMinX(b)) <= 1 && fabs(NSMinY(a) - NSMinY(b)) <= 1 &&
+           fabs(NSMaxX(a) - NSMaxX(b)) <= 1 && fabs(NSMaxY(a) - NSMaxY(b)) <= 1;
+}
+
+static unsigned int nativefs_screen_id(NSScreen* screen)
+{
+    return [[[screen deviceDescription] objectForKey:@"NSScreenNumber"] unsignedIntValue];
+}
+
+/* The screen whose frame the content rect (Cocoa coordinates) covers exactly, or 0. */
+static unsigned int nativefs_screen_for_rect(NSRect rect)
+{
+    for (NSScreen* screen in [NSScreen screens])
+        if (nativefs_rects_close(rect, [screen frame])) return nativefs_screen_id(screen);
+    return 0;
+}
+
+/* A Cocoa content rect as Wine's rect, "(left,top)-(right,bottom)". */
+static NSString* nativefs_wine_rect(NSRect rect)
+{
+    [[WineApplicationController sharedController] flipRect:&rect];
+    return [NSString stringWithFormat:@"(%.0f,%.0f)-(%.0f,%.0f)", NSMinX(rect), NSMinY(rect), NSMaxX(rect), NSMaxY(rect)];
+}
+
+@interface WineWindow ()
+{
+    struct nfs_state nfs;
+    BOOL nfsInSpace;               /* in the driver's Space */
+    BOOL nfsTransition;            /* a transition the driver started, or took over from the player */
+    BOOL nfsExitRequested;         /* the current transition is the driver's exit */
+    unsigned int nfsTransitionSerial;
+    NSTimeInterval nfsTransitionStart;
+    BOOL nfsRequestBorderless;     /* Wine's last style request has no title bar */
+    NSRect nfsRequestWine;         /* Wine's last frame request (content, Wine's top-down space) */
+    BOOL nfsPendingFeaturesValid;  /* a style request recorded while AppKit owned the window */
+    struct macdrv_window_features nfsPendingFeatures;
+    NSRect nfsToldFor;             /* the request Wine was last told the Space's real frame for */
+    NSTimeInterval nfsTimerAt;
+    NSTimeInterval nfsKeepFrameUntil; /* just out of the Space: AppKit's own late frames don't count */
+    const char* nfsSkipped;
+}
+@end
