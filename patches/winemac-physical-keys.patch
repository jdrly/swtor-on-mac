+/* PhysicalKeyboard: the name of a character key's vkey on a US keyboard (0: not one) */
+static WCHAR us_key_char(unsigned int vkey)
+{
+    static const struct {
+        WORD vkey;
+        WCHAR wchar;
+    } oem_chars[] = {
+        { VK_OEM_1, ';' }, { VK_OEM_PLUS, '=' }, { VK_OEM_COMMA, ',' }, { VK_OEM_MINUS, '-' },
+        { VK_OEM_PERIOD, '.' }, { VK_OEM_2, '/' }, { VK_OEM_3, '`' }, { VK_OEM_4, '[' },
+        { VK_OEM_5, '\\' }, { VK_OEM_6, ']' }, { VK_OEM_7, '\'' }, { VK_OEM_102, '\\' },
+    };
+    int i;
+
+    if (('0' <= vkey && vkey <= '9') || ('A' <= vkey && vkey <= 'Z'))
+        return vkey;
+    for (i = 0; i < ARRAY_SIZE(oem_chars); i++)
+        if (oem_chars[i].vkey == vkey) return oem_chars[i].wchar;
+    return 0;
+}
+
