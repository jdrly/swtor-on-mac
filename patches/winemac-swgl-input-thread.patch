 /***********************************************************************
+ *              Raw mouse input thread
+ *
+ * While the mouse is disassociated for mouse-look (relativeMouseMode in
+ * cocoa_app.m), the relative moves are handed to a Wine thread of this
+ * process that does nothing else, and it sends them to the server right
+ * away, as Windows delivers input independently of the application's
+ * message loop.  Posted to the window's event queue instead, a move reaches
+ * the server, and with it the cursor position and raw input (DirectInput),
+ * only when the window's thread next processes events, which for a game is
+ * once per frame: depending on the phase of the game loop against the
+ * incoming moves, a frame then gets the motion of zero, one or two of them,
+ * and the camera turns unevenly.
+ *
+ * The moves come from two sources (see cocoa_app.m): GameController's
+ * GCMouse, which reports the device's raw deltas as they arrive, on a
+ * dispatch queue of our own; or, without one, AppKit's mouse events on the
+ * main thread, which AppKit coalesces to one per display refresh and
+ * delivers about a refresh late, so that they are quantised like a game
+ * loop that reads them once per frame.
+ *
+ * Threading:
+ *
+ * - The producers are the main thread (-handleMouseMove:) and the GCMouse
+ *   queue, neither of them a Wine thread.  They never wait for a Wine thread:
+ *   raw_moves_producer_lock is only taken by them, around filling a slot,
+ *   and a byte written to a non-blocking pipe wakes the input thread.  When
+ *   the input thread is not running or the ring is full, the main thread
+ *   posts the move to the event queue as before and the GCMouse queue holds
+ *   it back and tries again.
+ *
+ * - The consumers are the input thread and the threads about to send a mouse
+ *   event from their event queue (flush_raw_mouse_moves).  They take moves
+ *   from the ring and send them while holding raw_moves_mutex, so whoever gets
+ *   the mutex knows that every move taken from the ring before has reached
+ *   the server.  Sending a relative move neither calls back into the driver
+ *   nor waits for another thread (no SEND_HWMSG_INJECTED, no button flags,
+ *   so no cursor clipping either), and the producers never take the mutex,
+ *   so holding it across the server call cannot deadlock.
+ *
+ * - Order against the mouse events that still go through the event queues
+ *   (buttons, scrolling, absolute moves, moves while the ring is full): a move
+ *   is handed over only while no mouse event exists that has not reached the
+ *   server (macdrv_mouse_events_pending), so a move never overtakes one posted
+ *   before it; and a thread sends the moves in the ring before it sends a
+ *   mouse event from its queue, so an event never overtakes a move handed
+ *   over before it.  A click during mouse-look therefore holds the moves
+ *   after it back until the game has processed the click, typically one
+ *   frame.  Only the main thread creates mouse events; for the GCMouse queue
+ *   the check is the point at which its move counts as made.
+ *
+ * - The moves keep everything else the main thread does with them: the warp
+ *   displacement is taken out of AppKit's deltas, relativeModeCursorPosition
+ *   follows them and the sub-pixel remainder carries over, before they are
+ *   handed over.
+ */
+struct raw_mouse_move
+{
+    HWND          hwnd;
+    int           dx;
+    int           dy;
+    int           drag;
+    int           source;   /* RAW_MOUSE_SOURCE_* */
+    unsigned int  events;   /* device or AppKit events in this move */
+    unsigned long time_ms;
+    UINT64        posted_ns;
+};
+
+#define RAW_MOVES_SIZE 256  /* a power of two */
+
+static struct raw_mouse_move raw_moves[RAW_MOVES_SIZE];
+static unsigned int raw_moves_head;  /* next to take; written by the consumers */
+static unsigned int raw_moves_tail;  /* next to fill; written by the producers */
+static os_unfair_lock raw_moves_producer_lock = OS_UNFAIR_LOCK_INIT;
+static pthread_mutex_t raw_moves_mutex = PTHREAD_MUTEX_INITIALIZER;
+static int raw_moves_wake_fd = -1;
+static int raw_input_thread_state;  /* 0: not started, 1: starting, 2: running, 3: ended */
+
+static const char * const raw_mouse_source_names[] = { "nsevent", "gcmouse" };
+
+/* Per-source totals for the once-a-second trace line: handed over, and AppKit
+   moves left out because GCMouse reports the same motion. */
+static struct raw_mouse_stats
+{
+    unsigned int events;
+    int          dx;
+    int          dy;
+} raw_mouse_stats[3];
+static UINT64 raw_mouse_stats_ns;
+static int raw_mouse_gc_mice;  /* GCMouse devices set up */
+
+static void add_raw_mouse_stats(struct raw_mouse_stats *stats, int dx, int dy, unsigned int events)
+{
+    __atomic_fetch_add(&stats->events, events, __ATOMIC_RELAXED);
+    __atomic_fetch_add(&stats->dx, dx, __ATOMIC_RELAXED);
+    __atomic_fetch_add(&stats->dy, dy, __ATOMIC_RELAXED);
+}
+
+static void trace_raw_mouse_stats(void)
+{
+    static const char * const names[] = { "nsevent", "gcmouse", "nsevent left out" };
+    UINT64 now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    char buf[256];
+    int i, len = 0;
+
+    if (!raw_mouse_stats_ns) raw_mouse_stats_ns = now;
+    if (now - raw_mouse_stats_ns < 1000000000) return;
+
+    for (i = 0; i < ARRAY_SIZE(raw_mouse_stats); i++)
+    {
+        unsigned int events = __atomic_exchange_n(&raw_mouse_stats[i].events, 0, __ATOMIC_RELAXED);
+        int dx = __atomic_exchange_n(&raw_mouse_stats[i].dx, 0, __ATOMIC_RELAXED);
+        int dy = __atomic_exchange_n(&raw_mouse_stats[i].dy, 0, __ATOMIC_RELAXED);
+        len += snprintf(buf + len, sizeof(buf) - len, "%s%s %u events (%d,%d)", i ? ", " : "",
+                        names[i], events, dx, dy);
+    }
+    TRACE("last %.2f s: %s; %d GCMouse device(s)\n", (now - raw_mouse_stats_ns) / 1e9, buf,
+          __atomic_load_n(&raw_mouse_gc_mice, __ATOMIC_RELAXED));
+    raw_mouse_stats_ns = now;
+}
+
+
+/***********************************************************************
+ *              send_raw_mouse_moves
+ *
+ * Send the moves waiting in the ring to the server.
+ */
+static void send_raw_mouse_moves(const char *sender)
+{
+    unsigned int head, tail;
+
+    pthread_mutex_lock(&raw_moves_mutex);
+
+    head = raw_moves_head;
+    tail = __atomic_load_n(&raw_moves_tail, __ATOMIC_ACQUIRE);
+    while (head != tail)
+    {
+        struct raw_mouse_move move = raw_moves[head++ % RAW_MOVES_SIZE];
+        unsigned int count = 1;
+
+        /* Moves that piled up for the same window go together; raw input
+           and the cursor end up the same. */
+        while (head != tail && raw_moves[head % RAW_MOVES_SIZE].hwnd == move.hwnd &&
+               raw_moves[head % RAW_MOVES_SIZE].drag == move.drag &&
+               raw_moves[head % RAW_MOVES_SIZE].source == move.source)
+        {
+            move.dx += raw_moves[head % RAW_MOVES_SIZE].dx;
+            move.dy += raw_moves[head % RAW_MOVES_SIZE].dy;
+            move.events += raw_moves[head % RAW_MOVES_SIZE].events;
+            move.time_ms = raw_moves[head % RAW_MOVES_SIZE].time_ms;
+            head++;
+            count++;
+        }
+        /* The slots are copied out; give them back to the producers. */
+        __atomic_store_n(&raw_moves_head, head, __ATOMIC_RELEASE);
+
+        TRACE("win %p relative (%d,%d) drag %d time %lu (%lu ticks ago) from %s, %u event(s) in %u move(s), "
+              "sent by %s %llu us after the first was handed over\n", move.hwnd, move.dx, move.dy, move.drag,
+              move.time_ms, (NtGetTickCount() - move.time_ms), raw_mouse_source_names[move.source],
+              move.events, count, sender,
+              (unsigned long long)((clock_gettime_nsec_np(CLOCK_UPTIME_RAW) - move.posted_ns) / 1000));
+
+        send_mouse_input(move.hwnd, NULL, MOUSEEVENTF_MOVE, move.dx, move.dy, 0, move.drag, move.time_ms);
+
+        tail = __atomic_load_n(&raw_moves_tail, __ATOMIC_ACQUIRE);
+    }
+
+    if (TRACE_ON(cursor)) trace_raw_mouse_stats();
+
+    pthread_mutex_unlock(&raw_moves_mutex);
+}
+
+
+/***********************************************************************
+ *              flush_raw_mouse_moves
+ *
+ * Called before a mouse event from an event queue is sent, so that it
+ * does not overtake the moves that were handed to the input thread before
+ * the event was posted.
+ */
+static void flush_raw_mouse_moves(void)
+{
+    if (__atomic_load_n(&raw_input_thread_state, __ATOMIC_ACQUIRE) >= 2)
+        send_raw_mouse_moves("event thread");
+}
+
+
+/***********************************************************************
+ *              macdrv_raw_input_thread_running
+ *
+ * Whether moves can be handed over to the raw input thread.
+ */
+int macdrv_raw_input_thread_running(void)
+{
+    return __atomic_load_n(&raw_input_thread_state, __ATOMIC_ACQUIRE) == 2;
+}
+
+
+/***********************************************************************
+ *              macdrv_post_raw_mouse_move
+ *
+ * Called on the main thread or the GCMouse queue.  Hands a relative move
+ * made of the given number of device or AppKit events over to the input
+ * thread.  Returns zero if it cannot take it now (input thread not
+ * running, mouse events pending, ring full).
+ */
+int macdrv_post_raw_mouse_move(void *hwnd, int dx, int dy, int drag, unsigned long time_ms,
+                               int source, unsigned int events)
+{
+    struct raw_mouse_move *move;
+    unsigned int tail;
+    char wake = 1;
+
+    if (!macdrv_raw_input_thread_running())
+        return 0;
+    if (macdrv_mouse_events_pending())
+        return 0;
+
+    os_unfair_lock_lock(&raw_moves_producer_lock);
+    tail = raw_moves_tail;  /* only written under this lock */
+    if (tail - __atomic_load_n(&raw_moves_head, __ATOMIC_ACQUIRE) >= RAW_MOVES_SIZE)
+    {
+        os_unfair_lock_unlock(&raw_moves_producer_lock);
+        return 0;
+    }
+    move = &raw_moves[tail % RAW_MOVES_SIZE];
+    move->hwnd      = hwnd;
+    move->dx        = dx;
+    move->dy        = dy;
+    move->drag      = drag;
+    move->source    = source;
+    move->events    = events;
+    move->time_ms   = time_ms;
+    move->posted_ns = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    __atomic_store_n(&raw_moves_tail, tail + 1, __ATOMIC_RELEASE);
+    os_unfair_lock_unlock(&raw_moves_producer_lock);
+
+    add_raw_mouse_stats(&raw_mouse_stats[source], dx, dy, events);
+
+    /* A full pipe already holds plenty of wake-ups. */
+    while (write(raw_moves_wake_fd, &wake, 1) < 0 && errno == EINTR);
+    return 1;
+}
+
+
+/***********************************************************************
+ *              macdrv_note_left_out_mouse_move
+ *
+ * Called on the main thread for an AppKit move that is not sent because
+ * GCMouse reports the same motion; for the trace, to compare the two.
+ */
+void macdrv_note_left_out_mouse_move(int dx, int dy)
+{
+    add_raw_mouse_stats(&raw_mouse_stats[2], dx, dy, 1);
+}
+
+
+/***********************************************************************
+ *              macdrv_note_game_controller_mouse
+ *
+ * Called on the main thread when a GCMouse device was set up; for the trace.
+ */
+void macdrv_note_game_controller_mouse(void)
+{
+    __atomic_fetch_add(&raw_mouse_gc_mice, 1, __ATOMIC_RELAXED);
+}
+
+
+/***********************************************************************
+ *              macdrv_raw_input_thread
+ *
+ * The body of the raw input thread, a Wine thread of this process created
+ * by the PE side when the driver is loaded.  Returns only if disabled or on
+ * failure; at process exit the thread is terminated with the others.
+ */
+NTSTATUS macdrv_raw_input_thread(void *arg)
+{
+    int fds[2], expected = 0;
+    char buf[64];
+    ssize_t len;
+
+    if (!raw_mouse_when_cursor_hidden || !raw_mouse_input_thread)
+    {
+        TRACE("disabled\n");
+        return STATUS_SUCCESS;
+    }
+    if (!__atomic_compare_exchange_n(&raw_input_thread_state, &expected, 1, FALSE,
+                                     __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE))
+    {
+        WARN("already started\n");
+        return STATUS_SUCCESS;
+    }
+
+    if (pipe(fds) ||
+        fcntl(fds[0], F_SETFD, FD_CLOEXEC) == -1 ||
+        fcntl(fds[1], F_SETFD, FD_CLOEXEC) == -1 ||
+        fcntl(fds[1], F_SETFL, O_NONBLOCK) == -1)
+    {
+        ERR("failed to create the wake-up pipe: %s\n", strerror(errno));
+        __atomic_store_n(&raw_input_thread_state, 3, __ATOMIC_RELEASE);
+        return STATUS_UNSUCCESSFUL;
+    }
+
+    /* As responsive as the main thread that feeds it; it is idle otherwise. */
+    pthread_set_qos_class_self_np(QOS_CLASS_USER_INTERACTIVE, 0);
+
+    raw_moves_wake_fd = fds[1];
+    __atomic_store_n(&raw_input_thread_state, 2, __ATOMIC_RELEASE);
+    TRACE("running\n");
+
+    for (;;)
+    {
+        len = read(fds[0], buf, sizeof(buf));
+        if (len < 0 && errno == EINTR) continue;
+        if (len <= 0) break;
+        send_raw_mouse_moves("input thread");
+    }
+
+    /* Moves still in the ring are sent by the next queued mouse event. */
+    ERR("wake-up pipe failed: %s\n", len ? strerror(errno) : "closed");
+    __atomic_store_n(&raw_input_thread_state, 3, __ATOMIC_RELEASE);
+    return STATUS_UNSUCCESSFUL;
+}
