+    - (BOOL) isStaleCursorPosition:(CGPoint)pos
+    {
+        NSTimeInterval now = [[NSProcessInfo processInfo] systemUptime];
+        CGPoint current = NSPointToCGPoint([self flippedMouseLocation:[NSEvent mouseLocation]]);
