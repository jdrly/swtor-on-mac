 /***********************************************************************
+ *              Thread CPU statistics (SWTOR on Mac, warn+threadcpu)
+ *
+ * Once a second, from the raw input thread: the CPU time this process and
+ * each of its threads used in that second, and that of the session's
+ * wineserver, in ms.  One "THREADCPU" line with the busiest threads, for
+ * telling a game thread that runs out of frame time from Wine or the
+ * window server being slow.  Read from the kernel's per-thread counters
+ * (proc_pidinfo), about a hundred cheap calls a second; nothing else runs.
+ */
+struct thread_cpu
+{
+    uint64_t handle;
+    uint64_t ns;
+};
+
+#define THREAD_CPU_MAX 1024
+
+static struct thread_cpu thread_cpu_prev[THREAD_CPU_MAX];
+static int thread_cpu_prev_count;
+static UINT64 thread_cpu_prev_time, thread_cpu_server_ns;
+static pid_t thread_cpu_server = -1;  /* -1: not looked up yet, 0: not found */
+
+/* The wineserver of this engine: <engine>/bin/wineserver, the engine being
+   four levels above this library (lib/wine/x86_64-unix/winemac.so). */
+static pid_t find_wineserver(void)
+{
+    char path[PATH_MAX], want[PATH_MAX], real[PATH_MAX], *p;
+    Dl_info info;
+    pid_t *pids;
+    int i, n, found = 0;
+
+    if (!dladdr((void *)find_wineserver, &info) || !realpath(info.dli_fname, path)) return 0;
+    for (i = 0; i < 4; i++)
+    {
+        if (!(p = strrchr(path, '/'))) return 0;
+        *p = 0;
+    }
+    snprintf(real, sizeof(real), "%s/bin/wineserver", path);
+    if (!realpath(real, want)) return 0;
+
+    if ((n = proc_listpids(PROC_ALL_PIDS, 0, NULL, 0)) <= 0 || !(pids = malloc(n))) return 0;
+    n = proc_listpids(PROC_ALL_PIDS, 0, pids, n) / sizeof(*pids);
+    for (i = 0; i < n && !found; i++)
+    {
+        size_t len;
+        if (pids[i] <= 1 || proc_pidpath(pids[i], path, sizeof(path)) <= 0) continue;
+        len = strlen(path);
+        if (len < 11 || strcmp(path + len - 11, "/wineserver")) continue;
+        if (realpath(path, real) && !strcmp(real, want)) found = pids[i];
+    }
+    free(pids);
+    return found;
+}
+
+/* PROC_PIDTASKINFO's times are Mach absolute-time ticks, not nanoseconds: 41.67 ns each on
+   Apple silicon (hw.tbfrequency 24 MHz), also for a process under Rosetta, whose
+   mach_timebase_info says 1/1. (PROC_PIDTHREADINFO's thread times are nanoseconds.) */
+static uint64_t thread_cpu_ticks_to_ns(uint64_t ticks)
+{
+    static uint64_t freq;
+
+    if (!freq)
+    {
+        uint64_t f = 0;
+        size_t size = sizeof(f);
+        if (sysctlbyname("hw.tbfrequency", &f, &size, NULL, 0) || !f) f = 1000000000;
+        freq = f;
+    }
+    return ticks / freq * 1000000000 + ticks % freq * 1000000000 / freq;
+}
+
+static void trace_thread_cpu(void)
+{
+    static uint64_t handles[THREAD_CPU_MAX];
+    struct thread_cpu now_cpu[THREAD_CPU_MAX];
+    struct { uint64_t handle; uint64_t ns; char name[MAXTHREADNAMESIZE]; } top[8];
+    UINT64 now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    pid_t pid = getpid();
+    uint64_t total = 0, server = 0;
+    int i, j, n, count = 0, ntop = 0, len = 0;
+    char buf[1024];
+
+    if (thread_cpu_server < 0) thread_cpu_server = find_wineserver();
+    if (thread_cpu_server > 0)
+    {
+        struct proc_taskinfo ti;
+        if (proc_pidinfo(thread_cpu_server, PROC_PIDTASKINFO, 0, &ti, sizeof(ti)) == sizeof(ti))
+        {
+            uint64_t ns = thread_cpu_ticks_to_ns(ti.pti_total_user + ti.pti_total_system);
+            server = thread_cpu_server_ns ? ns - thread_cpu_server_ns : 0;
+            thread_cpu_server_ns = ns;
+        }
+        else thread_cpu_server = -1;  /* gone (a new session?): look again next time */
+    }
+
+    n = proc_pidinfo(pid, PROC_PIDLISTTHREADS, 0, handles, sizeof(handles)) / (int)sizeof(*handles);
+    memset(top, 0, sizeof(top));
+    for (i = 0; i < n; i++)
+    {
+        struct proc_threadinfo info;
+        uint64_t used = 0;
+
+        if (proc_pidinfo(pid, PROC_PIDTHREADINFO, handles[i], &info, sizeof(info)) != sizeof(info)) continue;
+        now_cpu[count].handle = handles[i];
+        now_cpu[count].ns = info.pth_user_time + info.pth_system_time;
+        for (j = 0; j < thread_cpu_prev_count; j++)
+            if (thread_cpu_prev[j].handle == handles[i]) break;
+        /* a new thread (or a new one with an ended thread's handle: its time went down) */
+        if (j < thread_cpu_prev_count && now_cpu[count].ns >= thread_cpu_prev[j].ns)
+            used = now_cpu[count].ns - thread_cpu_prev[j].ns;
+        else if (thread_cpu_prev_time)
+            used = now_cpu[count].ns;
+        total += used;
+        count++;
+
+        /* keep the busiest, sorted */
+        for (j = ntop; j > 0 && top[j - 1].ns < used; j--)
+            if (j < ARRAY_SIZE(top)) top[j] = top[j - 1];
+        if (j < ARRAY_SIZE(top))
+        {
+            top[j].handle = handles[i];
+            top[j].ns = used;
+            memcpy(top[j].name, info.pth_name, sizeof(top[j].name));
+            top[j].name[sizeof(top[j].name) - 1] = 0;
+            if (ntop < ARRAY_SIZE(top)) ntop++;
+        }
