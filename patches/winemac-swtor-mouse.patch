 /* CLOCK_UPTIME_RAW time of the last GCMouse delta, in or out of relative mode. */
 static uint64_t gc_mouse_last_delta_ns;
 
+/* RawMouseMatchPointerSpeed (SWTOR on Mac): GCMouse reports device counts,
+   while the game's mouse-look was tuned to the macOS pointer (AppKit's
+   deltas, with the user's tracking speed and the Retina scale).  In
+   relative mode both report the same motion, so their ratio is measured:
+   Windows pixels per GCMouse count.  Until the first measurement AppKit's
+   moves are sent (through the input thread) and GCMouse's are only
+   counted; from then on GCMouse's are sent at that ratio (times
+   RawMouseGameControllerScale), and AppKit's are left out and keep
+   refining it.  Samples start 100 ms after relative mode was entered
+   (AppKit's moves arrive about a refresh after GCMouse's) and the window
+   in progress is dropped when it ends; AppKit motion counts only while
+   GCMouse reported in the last 100 ms (a device it does not report, e.g. a
+   trackpad, does not skew the ratio). */
+#define GC_CALIB_WINDOW_COUNTS  800.0
+static os_unfair_lock gc_calib_lock = OS_UNFAIR_LOCK_INIT;
+static double gc_calib_counts, gc_calib_pixels;
+static double gc_calib_ratio;          /* 0: not measured yet */
+static unsigned int gc_calib_samples;  /* windows measured */
+static uint64_t gc_calib_from_ns;      /* samples count from then on; 0: not in relative mode */
+
+static void gc_calib_restart(BOOL relative)
+{
+    os_unfair_lock_lock(&gc_calib_lock);
+    gc_calib_counts = gc_calib_pixels = 0;
+    gc_calib_from_ns = relative ? clock_gettime_nsec_np(CLOCK_UPTIME_RAW) + 100 * NSEC_PER_MSEC : 0;
+    os_unfair_lock_unlock(&gc_calib_lock);
+}
+
+/* counts: GCMouse motion (device counts); pixels: AppKit motion (Windows pixels) */
+static void gc_calib_add(double counts, double pixels)
+{
+    uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+
+    os_unfair_lock_lock(&gc_calib_lock);
+    if (gc_calib_from_ns && now >= gc_calib_from_ns)
+    {
+        gc_calib_counts += counts;
+        gc_calib_pixels += pixels;
+        if (gc_calib_counts >= GC_CALIB_WINDOW_COUNTS)
+        {
+            double ratio = gc_calib_pixels / gc_calib_counts;
+
+            /* A window without AppKit motion, or a wild one, tells nothing. */
+            if (ratio >= 0.02 && ratio <= 50)
+            {
+                gc_calib_ratio = gc_calib_ratio ? 0.75 * gc_calib_ratio + 0.25 * ratio : ratio;
+                gc_calib_samples++;
+            }
+            gc_calib_counts = gc_calib_pixels = 0;
+        }
+    }
+    os_unfair_lock_unlock(&gc_calib_lock);
+}
+
 /***********************************************************************
+ *              macdrv_raw_mouse_pixels_per_count
+ *
+ * The measured ratio (0 if none yet) and how many windows it is made of;
+ * for mouse.c's statistics line.
+ */
+double macdrv_raw_mouse_pixels_per_count(unsigned int *samples)
+{
+    double ratio;
+
+    os_unfair_lock_lock(&gc_calib_lock);
+    ratio = gc_calib_ratio;
+    if (samples) *samples = gc_calib_samples;
+    os_unfair_lock_unlock(&gc_calib_lock);
+    return ratio;
+}
+
+/* Windows pixels per GCMouse count to send, 0: leave the motion to AppKit. */
+static double gc_mouse_scale(void)
+{
+    double ratio;
+
+    if (!raw_mouse_match_pointer_speed)
+        return raw_mouse_game_controller_scale;
+    ratio = macdrv_raw_mouse_pixels_per_count(NULL);
+    return ratio * raw_mouse_game_controller_scale;
+}
+
