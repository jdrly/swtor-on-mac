+            len += snprintf(buf + len, sizeof(buf) - len, "%s%05llx%s%s%s %llu", i ? ", " : "",
+                            (unsigned long long)(top[i].handle >> 4) & 0xfffff,
+                            top[i].name[0] ? " \"" : "", top[i].name, top[i].name[0] ? "\"" : "",
+                            (unsigned long long)(top[i].ns / 1000000));
+        WARN_(threadcpu)("THREADCPU %.2f s: process %llu ms (%d threads), wineserver %llu ms%s; busiest (ms): %s\n",
+                         (now - thread_cpu_prev_time) / 1e9, (unsigned long long)(total / 1000000), count,
+                         (unsigned long long)(server / 1000000), thread_cpu_server > 0 ? "" : " (not found)",
