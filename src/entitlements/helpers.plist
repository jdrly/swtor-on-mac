<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- hold-launcher and setsid-exec under the hardened runtime. They run inside the launcher's
     Wine start and pass the environment on to Wine, which needs its DYLD_* variables
     (DYLD_FALLBACK_LIBRARY_PATH for the engine libraries): without this entitlement the
     hardened runtime would strip them from setsid-exec, and wineserver would not start. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-dyld-environment-variables</key><true/>
</dict>
</plist>
